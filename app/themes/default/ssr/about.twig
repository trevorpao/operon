{% extends "layout.twig" %}

{% block page %}
  <section class="hero is-medium is-light" style="background: url('{{ cu.cover|e }}') center/cover no-repeat;">
    <div class="hero-body">
      <div class="container">
        <h1 class="title is-2 mb-2">{{ cu.title|e }}</h1>
        <p class="subtitle is-5 has-text-grey-dark">{{ page.site_subtitle|e }}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="columns">
        <div class="column is-two-thirds">
          <div class="content">
            {{ cu.content|raw }}
          </div>
        </div>
        <div class="column">
          <div class="box">
            <h3 class="title is-6 mb-2">聯絡資訊</h3>
            <p><span class="icon"><i class="fas fa-envelope"></i></span> <a href="mailto:{{ opts.default.contact_mail|e }}">{{ opts.default.contact_mail|e }}</a></p>
            <p><span class="icon"><i class="fas fa-phone"></i></span> {{ opts.default.contact_phone|e }}</p>
            <p><span class="icon"><i class="fas fa-map-marker-alt"></i></span> {{ opts.default.contact_address|e }}</p>
          </div>
          <div class="box">
            <h3 class="title is-6 mb-2">社群連結</h3>
            <p><a href="{{ opts.social.facebook_page|e }}" target="_blank">Facebook</a></p>
            <p><a href="{{ opts.social.line_page|e }}" target="_blank">LINE</a></p>
            <p><a href="{{ opts.social.gmap_page|e }}" target="_blank">Google 地圖</a></p>
          </div>
          <div class="box">
            <h3 class="title is-6 mb-2">網站資訊</h3>
            <p>版本：{{ feVersion|e }}</p>
            <p>語言：{{ lang|e }}</p>
            <p>年份：{{ year|e }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
{% endblock %}
