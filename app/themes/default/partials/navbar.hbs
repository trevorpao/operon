{{!-- 主選單 Handlebars 模板（僅產生 nav 內部結構） --}}
<div class="navbar-brand  is-fixed-top">
  <a class="navbar-item" href="{{#if brandHref}}{{brandHref}}{{else}}/{{/if}}">
    <img src="/assets/img/logo.png" alt="{{#if brandLabel}}{{brandLabel}}{{else}}Menu{{/if}}" class="navbar-logo" />
    <span class="navbar-item__label">{{#if brandLabel}}{{brandLabel}}{{else}}Menu{{/if}}</span>
  </a>
  <button
    type="button"
    class="navbar-burger"
    aria-label="{{#if ariaLabel}}{{ariaLabel}}{{else}}主導航{{/if}}"
    aria-expanded="false"
    data-target="{{#if burgerTarget}}{{burgerTarget}}{{else}}navbar-menu{{/if}}"
  >
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
</div>

<div id="{{#if burgerTarget}}{{burgerTarget}}{{else}}navbar-menu{{/if}}" class="navbar-menu is-active">
  <div class="navbar-start">
    {{> menuList items=menu depth=0 parentPath="" }}
  </div>
</div>
