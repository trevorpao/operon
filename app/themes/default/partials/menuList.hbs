{{!-- Handlebars partial: menuList --}}
{{#if items.length}}
<ul
  class="menu-list {{listDepthClass depth}} {{#if depth}}navbar-dropdown{{else}}navbar-root{{/if}}"
  role="{{#if depth}}menu{{else}}menubar{{/if}}"
>
  {{#each items}}
    {{> menuItem
      node=this
      depth=../depth
      parentPath=../parentPath
    }}
  {{/each}}
</ul>
{{/if}}
